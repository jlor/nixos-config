{
  description = "NixOS desktop – Ryzen 7 9800X3D + RTX 5090";

  inputs = {
    # Current stable release (26.05 "Yarara", supported until 2026-12-31).
    # When 26.11 is out, bump this (and home-manager below) to 26.11.
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";

    # Manages dotfiles (Hyprland, Waybar, kitty, ...) from this repo
    home-manager = {
      url = "github:nix-community/home-manager/release-26.05";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # Encrypted secrets in this (public) repo, decrypted on the machine at boot
    sops-nix = {
      url = "github:Mic92/sops-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # GitOps: the machine pulls this repo and deploys new commits itself
    comin = {
      url = "github:nlewo/comin";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, home-manager, sops-nix, comin, ... }:
  let
    # allowUnfree: the bootstrap uses the 1Password CLI.
    pkgs = import nixpkgs { system = "x86_64-linux"; config.allowUnfree = true; };
    # Built with shellcheck, so a broken script fails CI rather than a fresh install.
    bootstrap = pkgs.writeShellApplication {
      name = "bootstrap";
      runtimeInputs = with pkgs; [
        git gh age sops jq _1password-cli                 # repo, keys, secrets
        yubikey-manager pam_u2f age-plugin-yubikey        # YubiKey steps
        util-linux diffutils gnused gnugrep gawk coreutils
      ];
      text = builtins.readFile ./bootstrap.sh;
    };
  in
  {
    # Set up a fresh install against this repo (see bootstrap.sh / README):
    #   nix --extra-experimental-features "nix-command flakes" run github:jlor/nixos-config#bootstrap
    packages.x86_64-linux.bootstrap = bootstrap;
    apps.x86_64-linux.bootstrap = {
      type = "app";
      program = "${bootstrap}/bin/bootstrap";
      meta.description = "Bootstrap this machine against the nixos-config repo";
    };

    # Project dev shells: `devshell <name>` (or `nix flake init -t github:jlor/nixos-config#<name>`)
    templates = {
      default = { path = ./templates/default; description = "Empty dev shell to fill in"; };
      node    = { path = ./templates/node;    description = "Node.js 24 + pnpm"; };
      java    = { path = ./templates/java;    description = "JDK 21 + Gradle + Maven"; };
      python  = { path = ./templates/python;  description = "Python 3.13 + uv + ruff"; };
      go      = { path = ./templates/go;      description = "Go + gopls + golangci-lint"; };
    };

    # The attribute name must match networking.hostName ("desktop"),
    # because comin picks the configuration by hostname.
    nixosConfigurations.desktop = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [
        ./hardware-configuration.nix   # generated by nixos-generate-config
        ./configuration.nix
        ./secrets.nix
        ./security.nix
        sops-nix.nixosModules.sops

        home-manager.nixosModules.home-manager
        {
          home-manager.useGlobalPkgs = true;
          home-manager.useUserPackages = true;
          # Existing files in the way get renamed to *.backup instead of failing
          home-manager.backupFileExtension = "backup";
          home-manager.users.jlor = import ./home.nix;
        }

        comin.nixosModules.comin
        {
          services.comin = {
            enable = true;
            remotes = [{
              name = "origin";
              url = "https://github.com/jlor/nixos-config.git";
              branches.main.name = "main";
              # Public repo, so no token is needed. If you make it private, add:
              # auth.access_token_path = "/etc/comin/github-token";
            }];
          };
        }
      ];
    };
  };
}
