{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,

  "modules-left": ["custom/logo", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "custom/gpu", "cpu", "memory", "pulseaudio", "bluetooth", "network", "custom/power"],

  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "walker"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": false,
    "persistent-workspaces": {
      "DP-1": [1, 2, 3, 4, 5],
      "HDMI-A-1": [6, 7, 8, 9]
    }
  },

  "hyprland/window": {
    "max-length": 48,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d %B %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "weeks": "<span color='#6c7086'>{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  // Reads the GPU through nvtop, not nvidia-smi. ROLLBACK AT 26.11: restore the
  // nvidia-smi one-liner in git history once configuration.nix drops the
  // nixpkgs-unstable kernel pin and Nvidia comes from stable again.
  //
  // The 7.2 kernel pin makes hardware.nvidia.package build from the unstable
  // kernel's stdenv, so Nvidia's prebuilt executables get patchelfed to glibc
  // 2.44 while this system is 2.42 — and nvidia-smi then segfaults in ld.so on
  // every call, which emptied this module. Only the executables break;
  // libnvidia-ml and libcuda load fine across the mix, which is why nvtop (and
  // NInfer) are unaffected. nvtop is the same figures from the same library,
  // via a binary that stable built against the right libc.
  "custom/gpu": {
    "exec": "nvtop -s | jq -r '.[0] | \"\\(.gpu_util)  \\(.temp | sub(\"C$\"; \"°C\"))\"'",
    "format": "󰢮  {}",
    "interval": 5,
    "tooltip": false
  },

  "cpu": {
    "format": "󰍛  {usage}%",
    "interval": 3
  },

  "memory": {
    "format": "󰘚  {percentage}%",
    "interval": 5
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "walker -m menus:power"
  }
}
